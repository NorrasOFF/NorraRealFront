# SSH Configuration
SSH_KEY=~/.ssh/your-ssh-key

# Docker Configuration
GHCR_USERNAME=username
GHCR_REPO=your-repo-name
GHCR_TOKEN=your_docker_token_here

DOMAIN=your-domain.com

# API Key
API_KEY=your_api_key_here

# Optional CDN origin (e.g. https://cdn.example.com) prepended to hashed asset
# URLs from asset-manifest.json. Leave empty to serve assets from the same
# origin as the app. No trailing slash.
CDN_BASE=

# Server Hosts
SERVER_HOST_STAGING=123.456.78.90
SERVER_HOST_NBG1=123.456.78.92

# Directory for resumable private-lobby saves (per-worker subdirs). Defaults
# to ./saves under the process working directory. Mount a volume here for
# saves to survive a container restart.
SAVE_DIR=

# Optional retention byte budget for one worker's save directory (default
# 2 GiB). Set this below the mount's real size when saves share a volume with
# AUTH_DIR, so old saves are pruned before the disk fills (e.g. 805306368 =
# 768 MiB on a 1 GB volume). Invalid values fall back to the default.
SAVE_DIR_BUDGET_BYTES=

# Self-hosted username/password accounts. Set LOCAL_AUTH=1 to enable.
# AUTH_DIR holds accounts.json and the JWT signing key (default ./auth-data).
# Mount a volume here for accounts to survive a container restart.
LOCAL_AUTH=0
AUTH_DIR=
LOCAL_AUTH_BASE=

# Version
VERSION_TAG="latest"

# Discord announcement posted when a ranked match starts. Create a webhook in
# the server's channel settings and paste its URL here. Leave empty to disable
# (no request is made). PUBLIC_SITE_URL overrides the origin used for the
# message's game link; it defaults to https://[SUBDOMAIN.]DOMAIN.
DISCORD_RANKED_WEBHOOK_URL=
PUBLIC_SITE_URL=

# Private match telemetry (disabled by default)
TELEMETRY_ENABLED=false
TELEMETRY_INGEST_URL=
TELEMETRY_SIGNING_SECRET=
TELEMETRY_BATCH_SIZE=200
TELEMETRY_FLUSH_INTERVAL_MS=1000
TELEMETRY_REQUEST_TIMEOUT_MS=5000
TELEMETRY_MAX_QUEUE_SIZE=20000
TELEMETRY_MAX_QUEUE_BYTES=33554432
TELEMETRY_MAX_EVENT_BYTES=1048576
TELEMETRY_PER_PLAYER_PER_TICK_CAP=32
